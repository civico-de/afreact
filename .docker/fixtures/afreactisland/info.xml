<?xml version="1.0"?>
<extension key="afreactisland" type="module">
  <file>afreactisland</file>
  <name>afreact island fixture</name>
  <description>A display type with only an Angular editor, a builder panel and FormBuilder plugins (element, input type, behavior, entity options), for afreact's browser tests.</description>
  <license>AGPL-3.0-or-later</license>
  <maintainer>
    <author>civico GmbH</author>
    <email>johannes@civico.de</email>
  </maintainer>
  <releaseDate>2026-10-11</releaseDate>
  <version>1.0</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>6.9</ver>
  </compatibility>
  <requires>
    <ext>org.civicrm.search_kit</ext>
    <ext>org.civicrm.afform_admin</ext>
  </requires>
  <classloader>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <mixins>
    <mixin>ang-php@1.0.0</mixin>
    <mixin>mgd-php@1.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
</extension>
